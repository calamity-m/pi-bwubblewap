{
  "name": "pi-bwubblewap",
  "version": "0.1.0",
  "description": "Bubblewrap sandboxing for Pi built-in tools",
  "type": "module",
  "keywords": ["pi-package"],
  "license": "MIT",
  "author": "calamity-m",
  "engines": { "node": ">=22.19.0" },
  "files": ["extensions/", "src/", "scripts/", "README.md", "LICENSE"],
  "pi": { "extensions": ["./extensions/index.ts"] },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types $(find tests -maxdepth 1 -name '*.test.ts' ! -name '*.integration.test.ts' -print)",
    "test:integration": "node --test --experimental-strip-types tests/*.integration.test.ts",
    "lint": "oxlint extensions src tests scripts",
    "format": "oxfmt --write extensions src tests scripts",
    "format:check": "oxfmt --check extensions src tests scripts",
    "pack:dry-run": "npm pack --dry-run",
    "bench": "node scripts/bench.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^24.10.0",
    "oxfmt": "^0.17.0",
    "oxlint": "^1.32.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.3"
  }
}
